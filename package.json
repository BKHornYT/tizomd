{
  "name": "tizomd",
  "productName": "TizoMD",
  "version": "0.1.5",
  "description": "A markdown viewer and editor for desktop",
  "author": "BKHornYT",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "icon": "node scripts/build-icon.mjs",
    "test": "npm run typecheck && npm run test:blocks && npm run test:session && npm run test:guard",
    "test:blocks": "node --experimental-strip-types scripts/test-blocks.ts",
    "test:session": "node --experimental-strip-types --import ./scripts/electron-stub-register.mjs scripts/test-session.ts",
    "test:guard": "node --experimental-strip-types scripts/test-guard.ts"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "electron-updater": "6.8.9",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
